{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python -m src.main --status)",
      "Bash(python -m src.main --list-courses)",
      "Bash(python -m src.main --once:*)",
      "Bash(python -m src.main --set-times:*)",
      "Bash(python -m src.main --set-courses:*)",
      "Bash(python -m src.main --check-on)",
      "Bash(python -m src.main --check-off)",
      "Bash(python -m src.main --download-on)",
      "Bash(python -m src.main --download-off)",
      "Bash(python -m src.main --mail-on)",
      "Bash(python -m src.main --mail-off)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Read(./id_password.txt)",
      "Read(./smtp_password.txt)"
    ],
    "deny": [
      "Read(./data/auth_profile/**)",
      "Read(./.env)"
    ]
  }
}
